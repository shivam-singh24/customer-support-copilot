# Python cache
__pycache__/
*.py[cod]
*.pyo
*.pyd
.ipynb_checkpoints/

# Virtual environments and secrets
.env
.env.local
.env.*.local
!.env.example
venv/
.venv/

# Streamlit secrets
.streamlit/secrets.toml

# Generated vector indexes
# Keep only the small deployment-ready multilingual FAISS index.
# Other regenerated vector indexes should remain untracked.
vectorstore/*
!vectorstore/faiss_policy_index_multilingual/
!vectorstore/faiss_policy_index_multilingual/**

# Raw datasets can be large/private
data/raw/

# Local model/cache directories that may become large
.cache/
hf_cache/
huggingface/

# Optional generated output folder
# Keep curated validation artifacts in reports/ and screenshots in docs/screenshots/.
outputs/

# OS/editor junk
.DS_Store
Thumbs.db
.vscode/
.idea/

# Logs and temporary files
*.log
tmp/
temp/

# Jupyter/runtime
.jupyter/
*.pid

# Testing and coverage
.pytest_cache/
.coverage
htmlcov/

# Build/package artifacts
build/
dist/
*.egg-info/
